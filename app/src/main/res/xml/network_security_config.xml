<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only by default: the gateway is expected to be TLS-terminated so the
     page can open a same-origin wss:// socket. To point the app at a plaintext
     LAN gateway during development, add that host under a
     <domain-config cleartextTrafficPermitted="true"> block here and rebuild. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
